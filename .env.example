# ── База данных ──────────────────────────────────────────────
# Оставьте DATABASE_URL пустым → используется локальный SQLite (default, работает без Docker).
# Для PostgreSQL через docker compose:
#   DATABASE_URL=postgresql+psycopg2://msxfit:msxfit@localhost:5432/msxfit
DATABASE_URL=

# ── Redis (кэш дневных итогов, опционально) ─────────────────
# Пусто → кэш отключается, итоги считаются на лету.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ── Прочее ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-prod
FLASK_DEBUG=1
CACHE_TTL=300
