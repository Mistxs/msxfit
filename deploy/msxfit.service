[Unit]
Description=mistxs | fitness — gunicorn API
After=network.target

[Service]
User=mistxs
Group=mistxs
WorkingDirectory=/home/mistxs/msxfit/backend
Environment=PYTHONPATH=/home/mistxs/msxfit/backend
EnvironmentFile=/home/mistxs/msxfit/backend/.env
ExecStart=/home/mistxs/msxfit/backend/.venv/bin/gunicorn --workers 1 --threads 4 -b 127.0.0.1:7800 wsgi:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
